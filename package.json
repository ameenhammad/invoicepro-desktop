{
  "name": "invoicepro",
  "version": "1.0.0",
  "description": "Offline Desktop Invoicing and Bookkeeping System for Small Businesses",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --dir",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "author": "InvoicePro",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.4.3",
    "electron-log": "^5.1.1",
    "pdfkit": "^0.14.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "electron": "^28.2.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.invoicepro.app",
    "productName": "InvoicePro",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "data/**/*"
    ],
    "extraResources": [
      {
        "from": "build",
        "to": "build"
      }
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
